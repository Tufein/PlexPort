# Alleen voor compose.build.yaml en compose.transmission.yaml.
# compose.yaml en compose.truenas.yaml voor TrueNAS gebruiken geen .env.
# Kopieer dit bestand naar .env en kies een eigen app-wachtwoord.
PLEXPORT_PASSWORD=kies-een-eigen-app-wachtwoord
# Je bestaande qBittorrent Web UI op de NAS, bijvoorbeeld http://192.168.1.20:8080.
# Vul je werkelijke adres in; gebruikersnaam en wachtwoord vul je in de app in.
QBITTORRENT_URL=
# Downloadmap gezien door qBittorrent, bijvoorbeeld /downloads of /volume1/downloads.
QBITTORRENT_DOWNLOAD_ROOT=/downloads

# Alleen nodig bij de optionele compose.transmission.yaml:
TRANSMISSION_USER=plexport
TRANSMISSION_PASSWORD=kies-een-eigen-torrent-wachtwoord

# Werkelijke NAS-mappen. Pas deze aan naar je bestaande opslaglocaties.
# DOWNLOADS_PATH moet dezelfde map zijn als die waarin qBittorrent downloadt.
DOWNLOADS_PATH=./downloads
# Map die je Plex-server kan lezen. Hierin komen Movies en TV Shows.
MEDIA_PATH=./media

# Op Linux/NAS: gebruik de ID's van de eigenaar van je gedeelde mappen.
PUID=1000
PGID=1000
