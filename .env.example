# Alleen voor compose.build.yaml en compose.transmission.yaml.
# compose.yaml en compose.truenas.yaml voor TrueNAS gebruiken geen .env.
# Kopieer dit bestand naar .env en kies een eigen app-wachtwoord.
JELLYPORT_PASSWORD=kies-een-eigen-app-wachtwoord
# Je bestaande Transmission op de NAS (RPC-adres), bijvoorbeeld http://192.168.1.75:9091/transmission/rpc.
# Vul je werkelijke adres in; gebruikersnaam en wachtwoord vul je in de app in.
TRANSMISSION_URL=
# Downloadmap gezien door Transmission, bijvoorbeeld /downloads of /volume1/downloads.
TRANSMISSION_DOWNLOAD_ROOT=/downloads

# Alleen nodig bij compose.transmission.yaml (Transmission meegeleverd):
TRANSMISSION_USER=jellyport
TRANSMISSION_PASSWORD=kies-een-eigen-torrent-wachtwoord

# Werkelijke NAS-mappen. Pas deze aan naar je bestaande opslaglocaties.
# DOWNLOADS_PATH moet dezelfde map zijn als die waarin Transmission downloadt.
DOWNLOADS_PATH=/Home/Downloads
# Map die je Jellyfin-server kan lezen. Hierin komen Movies en TV Shows.
MEDIA_PATH=./media

# Op Linux/NAS: gebruik de ID's van de eigenaar van je gedeelde mappen.
PUID=1000
PGID=1000
